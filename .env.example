# Configuration du serveur RetroSave.
# Copier ce fichier vers .env en développement. Ne jamais commiter de secret.

# Environnement applicatif : dev ou prod.
APP_ENV=dev

# Métadonnées PostgreSQL 16.
DATABASE_URL=postgresql+asyncpg://retrosave:retrosave@db:5432/retrosave

# Stockage objet S3-compatible. MinIO est réservé au développement.
S3_ENDPOINT=http://minio:9000
# Dev Thor : IP LAN du PC (ex. http://192.168.1.20:9000).
# Prod R2 : laisser vide, S3_ENDPOINT est déjà public.
# S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET=retrosave-poc
S3_ACCESS_KEY_ID=retrosave
S3_SECRET_ACCESS_KEY=retrosave-dev
S3_FORCE_PATH_STYLE=true

# URLs présignées et limites de sécurité du POC.
PRESIGN_EXPIRES_S=900
MAX_UNIT_BYTES=268435456
IDEMPOTENCY_TTL_H=24
PENDING_UPLOAD_TTL_H=24

# Logs structurés du serveur.
LOG_LEVEL=DEBUG

# Production uniquement. Caddy sert https://api.${RETROSAVE_DOMAIN}.
RETROSAVE_DOMAIN=retrosave.example.com

# ─── Comptes hébergés (CLD-01) ───────────────────────────────────────────
# LAISSER VIDE pour un serveur personnel : l'authentification reste alors le
# jeton d'invitation, et personne n'a besoin d'un fournisseur d'identité pour
# héberger RetroSave chez lui.
#
# Renseigné, ce serveur accepte EN PLUS les JWT émis par le fournisseur — le
# parcours géré par ce fournisseur, en complément du jeton d'invitation.
#
# MÉTHODE RECOMMANDÉE : la clé publique publiée par le fournisseur. Le serveur
# ne détient alors AUCUN secret, et une fuite de ce fichier ne permet de forger
# aucun jeton. Exemple :
ACCOUNT_JWKS_URL=https://identite.exemple.fr/.well-known/jwks.json
# Repli pour un fournisseur qui ne publie pas de JWKS : un secret PARTAGÉ, donc
# un secret que ce serveur peut utiliser pour forger des jetons. À protéger
# comme un mot de passe. Laisser vide si ACCOUNT_JWKS_URL est renseigné.
ACCOUNT_JWT_SECRET=
# L'émetteur attendu, vérifié à chaque requête.
ACCOUNT_ISSUER=
# L'audience posée par le fournisseur pour un utilisateur connecté.
ACCOUNT_AUDIENCE=authenticated
