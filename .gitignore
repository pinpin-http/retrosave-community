# Secrets and local configuration
.env
.env.*
!.env.example
local.properties

# Project-local development tools and state
.tools/
.android/
.venv/
.cache/
.gradle/
.gradle-user-home/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Android / Gradle
**/.idea/
**/.kotlin/
**/build/
*.iml
captures/

# Editors and OS
.vscode/*
!.vscode/settings.json
.DS_Store
Thumbs.db

# Runtime logs and save-safety artifacts
*.log
*.tmp
*.rsc-bak
*.rsc-bak.*

# Sauvegardes réelles tirées d'un appareil (jamais de vraie save en dépôt)
.thor-backup/

# Rapports d'architecture générés : la source Markdown fait foi, les rendus se
# refont avec scripts/docs/render_architecture_report.py.
docs/architecture/*.html
docs/architecture/*.pdf

# Artefacts LaTeX du dossier technique
docs/dossier/*.pdf
docs/dossier/*.aux
