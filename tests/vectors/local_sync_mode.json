[
  {
    "name": "a_unit_nobody_touched_synchronises",
    "input": { "mode": "sync", "global_pause": false },
    "expected": "sync"
  },
  {
    "name": "a_paused_unit_is_left_alone",
    "input": { "mode": "paused", "global_pause": false },
    "expected": "skip_paused"
  },
  {
    "name": "a_unit_not_selected_on_this_device_is_left_alone",
    "input": { "mode": "excluded", "global_pause": false },
    "expected": "skip_excluded"
  },
  {
    "name": "the_global_pause_stops_a_unit_nobody_paused",
    "input": { "mode": "sync", "global_pause": true },
    "expected": "skip_paused"
  },
  {
    "name": "the_global_pause_does_not_change_an_already_paused_unit",
    "input": { "mode": "paused", "global_pause": true },
    "expected": "skip_paused"
  },
  {
    "name": "exclusion_survives_the_global_pause_being_lifted",
    "input": { "mode": "excluded", "global_pause": true },
    "expected": "skip_excluded"
  },
  {
    "name": "an_unreadable_mode_keeps_synchronising",
    "input": { "mode": "", "global_pause": false },
    "expected": "sync"
  },
  {
    "name": "an_unknown_mode_keeps_synchronising",
    "input": { "mode": "suspendu", "global_pause": false },
    "expected": "sync"
  },
  {
    "name": "an_unknown_mode_still_obeys_the_global_pause",
    "input": { "mode": "suspendu", "global_pause": true },
    "expected": "skip_paused"
  }
]
