<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Le thème système sert uniquement d'enveloppe à l'activité. Les couleurs
      et composants visuels sont ensuite fournis par Material 3 dans Compose.
    -->
    <style name="Theme.RetroSave" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
